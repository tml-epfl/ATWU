{
  "schema_version": 1,
  "benchmark": "RWKU",
  "model": "microsoft/Phi-3-mini-4k-instruct",
  "description": "Selected hyperparameters and aggregate results for the canonical 10-target RWKU batch-unlearning experiment.",
  "setting": {
    "targets": "canonical 10-subject batch",
    "forget_probe_levels": {
      "level1": "fill-in-the-blank probes",
      "level2": "direct question-answer probes",
      "level3": "ADVERSARIAL ATTACK probes (RWKU's attack suite: role-play/persona, in-context reasoning, misleading premise, multi-hop / indirect elicitation of the forgotten fact)"
    },
    "neighbor_probe_levels": {
      "level1": "fill-in-the-blank probes on neighbor subjects",
      "level2": "question-answer probes on neighbor subjects"
    }
  },
  "aggregation": {
    "unit": "RWKU probes across the canonical 10 targets",
    "note": "The reported values are target/probe aggregates, not repeated random-seed runs; targets must not be interpreted as seeds."
  },
  "metric_definitions": {
    "rwku_rouge_L_recall": "Standard RWKU metric: ROUGE-L recall of greedy generations against the gold answer. Lower is better on forget, higher on neighbor. R-LF = mean(forget L1,L2,L3); R-LN = mean(neighbor L1,L2); N_delta = R-LN - R-LF.",
    "J_P": "Judge accuracy under the PARAPHRASE attack: each probe is asked in its original form plus 9 LLM paraphrases; a sample counts as recalled if ANY variant elicits the gold fact (worst-case over paraphrases). LLM judge = gpt-5.4-mini, greedy decoding, 64 new tokens, 100 samples/level.",
    "J_ICR": "Judge accuracy under the IN-CONTEXT-RETENTION attack: the same probes prefixed with 3 neighbor-subject QA pairs as few-shot context, again worst-case over the paraphrase set.",
    "J_W": "Worst-case over the union of the paraphrase and ICR attack variants — i.e. the sample counts as NOT forgotten if any of the ~20 attacked prompts elicits the fact. This is the quantity the paper's FQ is built from.",
    "J_avg": "Average-case judge accuracy on neighbor (retain) probes; higher is better.",
    "FQ": "100 * (J_W_original - J_W_method) / J_W_original, with J_W averaged over forget levels 1-3. Higher = more forgetting. Matches the paper's FQ column.",
    "RD": "100 * (J_avg_original - J_avg_method) / J_avg_original, averaged over neighbor levels 1-2. Lower = less collateral damage. Matches paper RD.",
    "UQ": "[FQ - RD]_+ . Matches the paper's UQ column.",
    "FQ_level3": "FQ recomputed using only the adversarial-attack forget level.",
    "repetitiveness": "n-gram entropy x100 over 1000 RWKU utility_fluency generations; higher = less degenerate.",
    "winrate_vs_original": "LLM-judge win rate of the unlearned model vs the original checkpoint on the same open-ended generations; 0.5 = parity."
  },
  "notes": [
    "RMU has no RWKU run and is reported as '—' in the paper.",
    "The judge-based J_P, J_ICR, and J_W values use 100 samples per level; the ROUGE metrics use the full RWKU probe sets."
  ],
